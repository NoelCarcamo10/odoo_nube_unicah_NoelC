<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_unicah_prestamo" model="ir.ui.view">
        <field name="name">res.partner.form.unicah.prestamo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='unicah_page']" position="inside">
                <group string="Historial de Préstamos">
                    <field name="total_prestamos"/>
                    <field name="prestamo_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="equipo"/>
                            <field name="fecha_prestamo"/>
                            <field name="estado"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>